    "preview": "vite preview",
    "test": "jest **/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@microsoft/api-extractor": "^7.57.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "jest": "^30.2.0",
    "mockdate": "^3.0.5",
    "terser": "^5.46.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.0-beta.6",
    "vite": "^7.3.1"
